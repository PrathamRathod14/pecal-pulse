# Copy to .env (or run `python3 scripts/setup_env.py`, which generates the secrets).
# Keep real values only in your local, ignored .env. Environment variables override dotenv.

# --- Existing chat assistant (OpenRouter) ------------------------------------
OPENROUTER_API_KEY=
LLM_MODEL=meta/muse-spark-1.3-contributor
RESONING_LVL='low'
CHECKPOINT_PATH=data/runtime/chat-checkpoints.sqlite3

# --- Existing voice assistant (LiveKit Cloud inference: Deepgram STT + Cartesia TTS)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Reserved for the next sandbox execution slice.
DAYTONA_API_KEY=

# --- Data snapshot -------------------------------------------------------------
# synthetic-pulse-demo = deterministic, clearly labelled demo dataset (generated on startup).
# Use your private historical snapshot ID here when available.
PECAL_SNAPSHOT=synthetic-pulse-demo
# Set after publishing a matching offline analytics directory.
PECAL_ANALYTICS_ROOT=data/runtime/analytics-v3

# --- Pulse agents: Gemini (https://aistudio.google.com/apikey) -----------------
# Without a key the Strategy agent uses a clearly labelled deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Pulse security (generated by scripts/setup_env.py; never commit) -----------
PULSE_WEBHOOK_SECRET=
PULSE_SESSION_SECRET=
# demo = pick a demo identity without password (local only); password = PULSE_USER_<ID>_PASSWORD
PULSE_AUTH_MODE=demo
# Enables the demo scenarios (Gemini/n8n outage, short expiry, prompt-injection red team).
PULSE_DEMO_MODE=true
PULSE_APPROVAL_TTL_SECONDS=900
PULSE_AUTO_APPROVE_LOW_RISK=true
# Real customer e-mail is OFF. Even when true, n8n needs an SMTP credential configured.
PULSE_ALLOW_EXTERNAL_EMAIL=false

# --- n8n -----------------------------------------------------------------------
N8N_BASE_URL=http://127.0.0.1:5678
# Where n8n reaches the backend (compose sets http://backend:8001 automatically).
PULSE_BACKEND_URL=http://host.docker.internal:8001
# Where the backend tells n8n to call back (informational; n8n uses PULSE_BACKEND_URL).
PULSE_CALLBACK_BASE_URL=http://127.0.0.1:8001
N8N_ENCRYPTION_KEY=
