{
  "id": "PulseErrorHdl001",
  "name": "SignalPilot – Error handler",
  "active": true,
  "nodes": [
    {
      "id": "error-trigger",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "build-failure-report",
      "name": "Build failure report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e = $input.first().json;\nconst body = JSON.stringify({\n  failed_n8n_execution_id: String((e.execution && e.execution.id) || ''),\n  workflow: (e.workflow && e.workflow.name) || null,\n  node: (e.execution && e.execution.lastNodeExecuted) || null,\n  message: String((e.execution && e.execution.error && e.execution.error.message) || 'unknown error').slice(0, 400),\n});\nconst ts = String(Math.floor(Date.now() / 1000));\nreturn [{ json: { body, ts, message: ts + '.' + body } }];"
      }
    },
    {
      "id": "sign-failure-report",
      "name": "Sign failure report",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        380,
        200
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.message }}",
        "dataPropertyName": "sig",
        "secret": "__PULSE_WEBHOOK_SECRET__",
        "encoding": "hex"
      }
    },
    {
      "id": "report-failure-to-signalpilot",
      "name": "Report failure to SignalPilot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "__PULSE_BACKEND_URL__/api/pulse/n8n/error",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Pulse-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-Pulse-Signature",
              "value": "={{ $json.sig }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Build failure report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build failure report": {
      "main": [
        [
          {
            "node": "Sign failure report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign failure report": {
      "main": [
        [
          {
            "node": "Report failure to SignalPilot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}
