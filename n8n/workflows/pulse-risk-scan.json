{
  "id": "PulseRiskScan001",
  "name": "SignalPilot – Risk-triggered investigations",
  "active": true,
  "nodes": [
    {
      "id": "schedule",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "id": "scan-webhook",
      "name": "Scan now webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        320
      ],
      "webhookId": "7a2f9c10-pulse-scan",
      "parameters": {
        "httpMethod": "POST",
        "path": "pulse-scan",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "prepare-scan-verification",
      "name": "Prepare scan verification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const canon = (v) => Array.isArray(v) ? '[' + v.map(canon).join(',') + ']'\n  : (v !== null && typeof v === 'object') ? '{' + Object.keys(v).sort().map(k => JSON.stringify(k) + ':' + canon(v[k])).join(',') + '}'\n  : JSON.stringify(v);\nconst safeEqual = (a, b) => { if (typeof a !== 'string' || typeof b !== 'string' || a.length !== b.length) return false;\n  let d = 0; for (let i = 0; i < a.length; i++) d |= a.charCodeAt(i) ^ b.charCodeAt(i); return d === 0; };\n\nconst item = $input.first().json;\nconst headers = item.headers || {};\nconst ts = String(headers['x-pulse-timestamp'] || '');\nreturn [{ json: { ts, sig: String(headers['x-pulse-signature'] || ''), body: item.body || {}, message: ts + '.' + canon(item.body || {}) } }];"
      }
    },
    {
      "id": "compute-scan-hmac",
      "name": "Compute scan HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        340,
        320
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.message }}",
        "dataPropertyName": "expected",
        "secret": "__PULSE_WEBHOOK_SECRET__",
        "encoding": "hex"
      }
    },
    {
      "id": "verify-scan-trigger",
      "name": "Verify scan trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const canon = (v) => Array.isArray(v) ? '[' + v.map(canon).join(',') + ']'\n  : (v !== null && typeof v === 'object') ? '{' + Object.keys(v).sort().map(k => JSON.stringify(k) + ':' + canon(v[k])).join(',') + '}'\n  : JSON.stringify(v);\nconst safeEqual = (a, b) => { if (typeof a !== 'string' || typeof b !== 'string' || a.length !== b.length) return false;\n  let d = 0; for (let i = 0; i < a.length; i++) d |= a.charCodeAt(i) ^ b.charCodeAt(i); return d === 0; };\n\nconst j = $input.first().json;\nconst ok = /^[0-9]+$/.test(j.ts) && Math.abs(Date.now() / 1000 - Number(j.ts)) <= 300 && safeEqual(j.expected, j.sig);\nif (!ok) throw new Error('Rejected unsigned scan trigger');\nreturn [{ json: { ok: true } }];"
      }
    },
    {
      "id": "build-scan-request",
      "name": "Build scan request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = JSON.stringify({ max_runs: 1, requested_by: 'n8n', n8n_execution_id: String($execution.id) });\nconst ts = String(Math.floor(Date.now() / 1000));\nreturn [{ json: { body, ts, message: ts + '.' + body } }];"
      }
    },
    {
      "id": "sign-scan-request",
      "name": "Sign scan request",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        820,
        200
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.message }}",
        "dataPropertyName": "sig",
        "secret": "__PULSE_WEBHOOK_SECRET__",
        "encoding": "hex"
      }
    },
    {
      "id": "ask-signalpilot-to-investigate",
      "name": "Ask SignalPilot to investigate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "__PULSE_BACKEND_URL__/api/pulse/n8n/scan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Pulse-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-Pulse-Signature",
              "value": "={{ $json.sig }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Every 6 hours": {
      "main": [
        [
          {
            "node": "Build scan request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scan now webhook": {
      "main": [
        [
          {
            "node": "Prepare scan verification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare scan verification": {
      "main": [
        [
          {
            "node": "Compute scan HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compute scan HMAC": {
      "main": [
        [
          {
            "node": "Verify scan trigger",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify scan trigger": {
      "main": [
        [
          {
            "node": "Build scan request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build scan request": {
      "main": [
        [
          {
            "node": "Sign scan request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign scan request": {
      "main": [
        [
          {
            "node": "Ask SignalPilot to investigate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "PulseErrorHdl001"
  },
  "pinData": {},
  "tags": []
}
